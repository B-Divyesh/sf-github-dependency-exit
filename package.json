{
  "name": "github-dependency-exit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "build": "npm run build:site",
    "build:site": "cargo build --release && vite build --config site/vite.config.ts && mkdir -p dist/site/downloads && cp target/release/github-exit dist/site/downloads/github-exit-linux-x86_64",
    "preview": "vite preview --config site/vite.config.ts",
    "test": "cargo test && playwright test",
    "test:site": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
